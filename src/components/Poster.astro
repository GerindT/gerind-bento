---
import { Icon } from "astro-icon/components";
import { statusLabels, techIcons, type Project } from "../lib/projects";

interface Props {
  project: Project;
  /** Position in its list, for the reveal stagger. */
  index?: number;
  /** Heading level inside the page outline. */
  level?: "h2" | "h3";
  /** Large feature plate (spans two columns). */
  feature?: boolean;
  /** Load the image straight away: the first poster on a page is often the LCP. */
  eager?: boolean;
}

const { project, index = 0, level = "h3", feature = false, eager = false } = Astro.props;
const Heading = level;
const primary = project.site ?? project.github;
const cardHref = `/projects/${project.slug}`;
---

<article class:list={["poster", "reveal", { "poster--feature": feature }]} style={`--i:${index % 6}`}>
  <div class:list={["poster__art", { "poster__art--contain": project.contain, "poster__art--type": !project.img }]} style={project.artBg ? `--art-bg:${project.artBg}` : undefined}>
    {
      project.img ? (
        <img src={project.img} alt={project.alt} loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : undefined} decoding="async" width="640" height="400" style={project.imgPos ? `object-position:${project.imgPos}` : undefined} />
      ) : (
        <span class="poster__initial" aria-hidden="true">
          {project.title}
        </span>
      )
    }
    <span class="poster__year">{project.year}</span>
    <span class="poster__dots halftone" aria-hidden="true"></span>
  </div>
  <div class="poster__body">
    <div class="poster__head">
      <Heading class="poster__title">
        <a class="poster__open" href={cardHref} data-cc-open={project.slug} aria-describedby="card-hint">{project.title}</a>
      </Heading>
      {project.role && <p class="strip strip--accent poster__role">{project.role}</p>}
    </div>
    <p class="poster__blurb">{project.blurb}</p>
    <ul class="chips" aria-label="Status">
      {project.statuses.map((s) => <li class:list={["chip", { "chip--live": s === "live" }]}>{statusLabels[s]}</li>)}
    </ul>
    {
      project.stacks.length > 0 && (
        <ul class="stack" aria-label="Built with">
          {project.stacks.map((s) => (
            <li>
              <Icon name={techIcons[s].icon} aria-hidden="true" />
              {techIcons[s].label}
            </li>
          ))}
        </ul>
      )
    }
    <div class="poster__links">
      {
        project.site && (
          <a class="textlink textlink--plate" href={project.site} target="_blank" rel="noopener noreferrer">
            {project.siteLabel ?? "Visit site"}
            <Icon name="ri:arrow-right-up-line" aria-hidden="true" />
            <span class="sr-only"> — {project.title} (opens in new tab)</span>
          </a>
        )
      }
      {
        project.github && (
          <a class:list={["textlink", { "textlink--plate": !project.site }]} href={project.github} target="_blank" rel="noopener noreferrer">
            Source
            <Icon name="ri:github-fill" aria-hidden="true" />
            <span class="sr-only"> — {project.title} on GitHub (opens in new tab)</span>
          </a>
        )
      }
      {
        project.paper && (
          <a class="textlink" href={project.paper} target="_blank" rel="noopener">
            Thesis
            <Icon name="ri:file-pdf-2-line" aria-hidden="true" />
            <span class="sr-only"> — {project.title}, PDF (opens in new tab)</span>
          </a>
        )
      }
      {!primary && <p class="poster__private"><Icon name="ri:lock-2-line" aria-hidden="true" /> {project.statuses.includes("offline") ? "No longer hosted" : "Private build"}</p>}
    </div>
  </div>
</article>
