---
import { Icon } from "astro-icon/components";
import { techIcons } from "../lib/projects";
import type { CardItem } from "../lib/cards";

interface Props {
  items: CardItem[];
}
const { items } = Astro.props;
---

<dialog class="callcard" id="callcard" aria-labelledby="callcard-title" data-callcard>
  <div class="callcard__bar">
    <p class="callcard__count" aria-live="polite">
      <span class="sr-only">Card </span><b data-cc-index>1</b><span aria-hidden="true">/</span><span class="sr-only"> of </span><span data-cc-total>1</span>
    </p>
    <div class="callcard__nav">
      <button type="button" class="callcard__btn" data-cc-prev aria-label="Previous card">
        <Icon name="ri:arrow-left-line" aria-hidden="true" />
      </button>
      <button type="button" class="callcard__btn" data-cc-next aria-label="Next card">
        <Icon name="ri:arrow-right-line" aria-hidden="true" />
      </button>
      <button type="button" class="callcard__btn callcard__btn--close" data-cc-close aria-label="Close card">
        <Icon name="ri:close-line" aria-hidden="true" />
      </button>
    </div>
  </div>
  <div class="callcard__body" data-cc-body></div>
  <p class="callcard__hint" aria-hidden="true"><kbd>←</kbd> <kbd>→</kbd> next card · <kbd>Esc</kbd> close</p>
</dialog>

{
  items.map((it) => (
    <template data-cc-item={it.id} data-cc-set={it.set}>
      <article class:list={["cc", { "cc--portrait": it.portrait, "cc--plain": it.images.length === 0 }]}>
        <figure class="cc__visual">
          <div class:list={["cc__frame", { "cc__frame--contain": it.contain }]} style={it.artBg ? `--art-bg:${it.artBg}` : undefined}>
            {it.images.length > 0 ? (
              <img data-cc-main src={it.images[0].src} alt={it.images[0].alt} decoding="async" width="1280" height="800" />
            ) : (
              <span class="cc__plate" aria-hidden="true">
                {it.title}
              </span>
            )}
          </div>
          {it.images.length > 1 && (
            <div class="cc__shots" role="group" aria-label="Screenshots">
              {it.images.map((im, i) => (
                <button type="button" class="cc__shot" data-cc-shot={i} data-src={im.src} data-alt={im.alt} aria-pressed={i === 0 ? "true" : "false"} aria-label={`Show screenshot ${i + 1}: ${im.alt}`}>
                  <img src={im.src} alt="" loading="lazy" decoding="async" width="160" height="100" />
                </button>
              ))}
            </div>
          )}
        </figure>
        <div class="cc__text">
          <h2 class="cc__title" id="callcard-title" tabindex="-1">
            {it.title}
          </h2>
          <p class="cc__meta">
            {it.meta.filter(Boolean).map((m, i) => (
              <span>{m}</span>
            ))}
          </p>
          {it.role && <p class="strip strip--accent cc__role">{it.role}</p>}
          {it.chips.length > 0 && (
            <ul class="chips" aria-label="Status">
              {it.chips.map((c) => (
                <li class:list={["chip", { "chip--live": c.hot }]}>{c.label}</li>
              ))}
            </ul>
          )}
          {it.lines.map((l) => (
            <p class="cc__line">{l}</p>
          ))}
          {it.stacks.length > 0 && (
            <ul class="stack cc__stack" aria-label="Built with">
              {it.stacks.map((s) => (
                <li>
                  <Icon name={techIcons[s].icon} aria-hidden="true" />
                  {techIcons[s].label}
                </li>
              ))}
            </ul>
          )}
          <div class="cc__links">
            {it.links.map((l) => (
              <a class:list={["textlink", { "textlink--plate": l.primary }]} href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label}
                <Icon name={l.icon} aria-hidden="true" />
                <span class="sr-only"> — {l.srLabel}</span>
              </a>
            ))}
            {it.privateNote && (
              <p class="poster__private">
                <Icon name="ri:lock-2-line" aria-hidden="true" /> {it.privateNote}
              </p>
            )}
          </div>
        </div>
      </article>
    </template>
  ))
}

<script>
  // Calling card: one native <dialog>, filled from server-rendered <template>s.
  // Each card has its own URL (?p=id), so Back closes it and links can be shared.
  const dlg = document.getElementById("callcard") as HTMLDialogElement | null;
  const body = dlg?.querySelector<HTMLElement>("[data-cc-body]");
  const templates = new Map(Array.from(document.querySelectorAll<HTMLTemplateElement>("template[data-cc-item]")).map((t) => [t.dataset.ccItem!, t]));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const ease = "cubic-bezier(0.16, 1, 0.3, 1)";
  const root = document.documentElement;

  if (dlg && body && templates.size) {
    let current: string | null = null;
    let pushed = false;
    let trigger: HTMLElement | null = null;
    let closing = false;

    const setOf = (id: string) => Array.from(templates.values()).filter((t) => t.dataset.ccSet === templates.get(id)!.dataset.ccSet).map((t) => t.dataset.ccItem!);
    const urlFor = (id: string | null) => {
      const u = new URL(location.href);
      if (id) u.searchParams.set("p", id);
      else u.searchParams.delete("p");
      return u.pathname + u.search + u.hash;
    };

    const render = (id: string, dir = 0) => {
      const tpl = templates.get(id);
      if (!tpl) return;
      current = id;
      body.replaceChildren(tpl.content.cloneNode(true));
      const set = setOf(id);
      dlg.querySelector("[data-cc-index]")!.textContent = String(set.indexOf(id) + 1);
      dlg.querySelector("[data-cc-total]")!.textContent = String(set.length);
      const single = set.length < 2;
      dlg.querySelectorAll<HTMLButtonElement>("[data-cc-prev], [data-cc-next]").forEach((b) => (b.hidden = single));
      if (dir && !reduce) {
        body.animate(
          [
            { opacity: 0, transform: `translateX(${dir * 2.5}rem) skewX(${dir * -5}deg)`, clipPath: dir > 0 ? "polygon(18% 0, 100% 0, 100% 100%, 0 100%)" : "polygon(0 0, 82% 0, 100% 100%, 0 100%)" },
            { opacity: 1, transform: "none", clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)" },
          ],
          { duration: 380, easing: ease }
        );
      }
      body.querySelector<HTMLElement>(".cc__title")?.focus({ preventScroll: true });
    };

    const open = (id: string, opts: { push?: boolean } = {}) => {
      if (!templates.has(id)) return false;
      if (!dlg.open) {
        dlg.showModal();
        root.classList.add("cc-open");
        if (!reduce) {
          dlg.animate(
            [
              { clipPath: "polygon(0 0, 0 0, -12% 100%, -12% 100%)", transform: "translateX(-3rem) skewX(4deg)" },
              { clipPath: "polygon(0 0, 112% 0, 100% 100%, -12% 100%)", transform: "none" },
            ],
            { duration: 460, easing: ease }
          );
          dlg.querySelector(".callcard__body")?.animate([{ opacity: 0 }, { opacity: 0, offset: 0.35 }, { opacity: 1 }], { duration: 460, easing: "linear" });
        } else {
          dlg.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 150 });
        }
        (window as any).sfx?.confirm();
      }
      render(id);
      if (opts.push) {
        history.pushState({ cc: id }, "", urlFor(id));
        pushed = true;
      }
      return true;
    };

    const finish = () => {
      dlg.close();
      root.classList.remove("cc-open");
      body.replaceChildren();
      current = null;
      closing = false;
      trigger?.focus({ preventScroll: true });
      trigger = null;
    };

    // Animate out, then close. `fromHistory` means the URL already changed.
    const close = (fromHistory = false) => {
      if (!dlg.open || closing) return;
      closing = true;
      if (!fromHistory) {
        if (pushed) {
          pushed = false;
          history.back(); // popstate lands here again with fromHistory = true
          closing = false;
          return;
        }
        history.replaceState(history.state, "", urlFor(null));
      }
      pushed = false;
      if (reduce) return finish();
      dlg
        .animate(
          [
            { clipPath: "polygon(0 0, 112% 0, 100% 100%, -12% 100%)", transform: "none", opacity: 1 },
            { clipPath: "polygon(112% 0, 112% 0, 100% 100%, 100% 100%)", transform: "translateX(2rem)", opacity: 1 },
          ],
          { duration: 260, easing: "cubic-bezier(0.7, 0, 0.84, 0)" }
        )
        .finished.then(finish, finish);
    };

    const step = (dir: 1 | -1) => {
      if (!current) return;
      const set = setOf(current);
      if (set.length < 2) return;
      const next = set[(set.indexOf(current) + dir + set.length) % set.length];
      render(next, dir);
      history.replaceState(history.state, "", urlFor(next));
      (window as any).sfx?.tick();
    };

    // Open from any [data-cc-open] link on the page.
    document.addEventListener("click", (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>("[data-cc-open]");
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey || (e as MouseEvent).button !== 0) return;
      if (!templates.has(a.dataset.ccOpen!)) return;
      e.preventDefault();
      trigger = a;
      open(a.dataset.ccOpen!, { push: !dlg.open });
    });

    dlg.querySelector("[data-cc-close]")?.addEventListener("click", () => close());
    dlg.querySelector("[data-cc-prev]")?.addEventListener("click", () => step(-1));
    dlg.querySelector("[data-cc-next]")?.addEventListener("click", () => step(1));
    dlg.addEventListener("cancel", (e) => {
      e.preventDefault();
      close();
    });
    // A click on the backdrop (the dialog box itself, outside the plate) closes.
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) close();
      const shot = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-cc-shot]");
      if (!shot) return;
      const main = body.querySelector<HTMLImageElement>("[data-cc-main]");
      if (!main) return;
      main.src = shot.dataset.src!;
      main.alt = shot.dataset.alt!;
      body.querySelectorAll("[data-cc-shot]").forEach((b) => b.setAttribute("aria-pressed", String(b === shot)));
      if (!reduce) main.animate([{ opacity: 0.2, transform: "scale(1.03)" }, { opacity: 1, transform: "none" }], { duration: 300, easing: ease });
    });
    dlg.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const keysOff = root.dataset.keys === "off";
      if (e.key === "ArrowRight" || (!keysOff && e.key.toLowerCase() === "e")) {
        e.preventDefault();
        step(1);
      } else if (e.key === "ArrowLeft" || (!keysOff && e.key.toLowerCase() === "q")) {
        e.preventDefault();
        step(-1);
      }
    });

    window.addEventListener("popstate", () => {
      const id = new URLSearchParams(location.search).get("p");
      if (id && templates.has(id)) {
        if (dlg.open) render(id);
        else open(id);
      } else if (dlg.open) {
        close(true);
      }
    });

    // Deep link: /projects?p=pasqyra opens straight onto that card.
    const deep = new URLSearchParams(location.search).get("p");
    if (deep && templates.has(deep)) {
      trigger = document.querySelector<HTMLElement>(`[data-cc-open="${CSS.escape(deep)}"]`);
      open(deep);
    }
  }
</script>
