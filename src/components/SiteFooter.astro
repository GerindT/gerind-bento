---
import { LINKS } from "../lib/constants";
import { hasPhotos } from "../lib/photos";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <p>© {year} Gerind Tershana · Built with <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">Astro</a>.</p>
    <nav aria-label="Footer" class="site-footer__nav">
      <a href="/projects">Projects</a>
      <a href="/about">About</a>
      {hasPhotos && <a href="/photos">Photos</a>}
      <a href="/media">Media</a>
      <button type="button" class="linkbtn" data-open-keys>Shortcuts (?)</button>
      <a href={LINKS.github} target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </nav>
  </div>
</footer>
