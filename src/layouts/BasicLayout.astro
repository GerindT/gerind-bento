---
import "../style.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Shortcuts from "../components/Shortcuts.astro";
import type { PageId } from "../components/SiteHeader.astro";
import { LINKS, SITE } from "../lib/constants";

interface Props {
  title: string;
  description: string;
  /** Marks the current nav entry. */
  page?: PageId;
  type?: "website" | "article";
  publishedTime?: string;
  /** Absolute path (or URL) of the social preview image. */
  image?: string;
  /** Alt text for a page-specific preview image. */
  imageAlt?: string;
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page. */
  jsonLd?: Record<string, unknown>[];
  /** Skip the load wipe (used by the 404 page). */
  noWipe?: boolean;
}

const { title, description, page, type = "website", publishedTime, image = "/og.png", imageAlt, noindex = false, jsonLd = [], noWipe = false } = Astro.props;

const siteUrl = Astro.site ?? new URL(SITE.url);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();

const person = {
  "@type": "Person",
  "@id": `${SITE.url}/#person`,
  name: SITE.name,
  url: SITE.url,
  image: new URL("/Gerind_Tershana.webp", siteUrl).toString(),
  jobTitle: "Tech Lead & System Architect",
  description: SITE.tagline,
  email: [LINKS.email, LINKS.email2],
  sameAs: [LINKS.linkedin, LINKS.github, LINKS.instagram, LINKS.telegram],
  knowsAbout: ["System architecture", "Backend development", "Go", "Node.js", "Laravel", "Vue", "Nuxt", "React", "PostgreSQL", "MySQL", "Docker", "Kubernetes", "CI/CD", "DevOps", "High-concurrency APIs"],
  worksFor: { "@type": "Organization", name: "Innovation4Albania" },
  alumniOf: [
    { "@type": "CollegeOrUniversity", name: "University of New York Tirana" },
    { "@type": "HighSchool", name: "Hermann Gmeiner" },
  ],
  award: ["Valedictorian, B.Sc. Computer Science, University of New York Tirana (2024)"],
  seeks: { "@type": "Demand", description: "Freelance projects and part-time roles" },
  knowsLanguage: ["sq", "en", "de"],
  address: { "@type": "PostalAddress", addressLocality: "Tirana", addressCountry: "AL" },
  nationality: { "@type": "Country", name: "Albania" },
};
const website = {
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  inLanguage: "en",
  publisher: { "@id": `${SITE.url}/#person` },
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [website, person, ...jsonLd],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Summary for AI assistants" />
    <link rel="preload" href="/fonts/CabinetGrotesk-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Satoshi-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
    <meta name="google-site-verification" content="Z7KRZM4pvjJO5VV2qVFNvmEHkHAfZd8ZlSgX1LGgN_U" />
    <meta name="google-site-verification" content="AQbVxrmT5AemOlTagqMrqdj1yTowivfYgadynXXHvZU" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={imageUrl} />
    {image === "/og.png" && <meta property="og:image:width" content="1200" />}
    {image === "/og.png" && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt ?? `${SITE.name} — ${SITE.tagline}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && <meta property="article:author" content={SITE.name} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <!-- Apply the saved accent before first paint, so there is no colour flash. -->
    <script is:inline>
      document.documentElement.classList.add("js");
      // Cross-document view transitions: the new page skips its own load wipe.
      window.addEventListener("pagereveal", function (e) {
        if (e.viewTransition) document.documentElement.classList.add("vt");
      });
      try {
        if (localStorage.getItem("keys") === "off") document.documentElement.dataset.keys = "off";
        var t = (localStorage.getItem("theme") || "").replace("-theme", "");
        if (t && t !== "default") document.documentElement.dataset.theme = t;
        if (localStorage.getItem("mode") === "light") document.documentElement.dataset.mode = "light";
      } catch (e) {}
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <!-- Cloudflare Web Analytics: cookieless page views. The token is public by design. -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ce8389015a1b44bbb41b135715c4e1a7"}' is:inline></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {!noWipe && <div class="wipe" aria-hidden="true" />}
    <SiteHeader current={page} />
    <slot />
    <SiteFooter />
    <Shortcuts />
    <div class="wipe-in" aria-hidden="true"></div>
    <script>
      // For anyone who opens devtools: a calling card in the console.
      console.log(
        "%c" +
          [
          "   ______   ______",
          "  / ____/  /_  __/",
          " / / __     / /   ",
          "/ /_/ /    / /    ",
          "\\____/    /_/     ",
        ].join("\n") +
          "\n\nGerind Tershana · Tech Lead & System Architect, Tirana\nYou opened the console, so you're my kind of visitor.\nHiring or building something? gerindt@gmail.com\nPress ? on the page for keyboard shortcuts.",
        "color:#e4112a;font-weight:700;line-height:1.3"
      );

      const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      // Browsers with cross-document view transitions animate navigation natively.
      const nativeVT = "onpagereveal" in window;

      // Scroll reveals: content is visible by default; only .js pages hide it until it enters.
      const reveal = new IntersectionObserver(
        (entries) => {
          for (const en of entries) {
            if (!en.isIntersecting) continue;
            en.target.classList.add("is-in");
            reveal.unobserve(en.target);
          }
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0 }
      );
      document.querySelectorAll(".reveal").forEach((el) => reveal.observe(el));

      if (!reduce) {
        // Click "shards": three slanted accent slashes burst from the pointer.
        document.addEventListener("pointerdown", (e) => {
          for (let i = 0; i < 3; i++) {
            const shard = document.createElement("span");
            shard.className = "shard";
            shard.style.left = `${e.clientX}px`;
            shard.style.top = `${e.clientY}px`;
            document.body.appendChild(shard);
            const angle = -60 + i * 60 + (Math.random() * 20 - 10);
            const dist = 26 + Math.random() * 18;
            const dx = Math.cos((angle * Math.PI) / 180) * dist;
            const dy = Math.sin((angle * Math.PI) / 180) * dist;
            shard
              .animate(
                [
                  { transform: `translate(-50%, -50%) rotate(${angle}deg) scaleX(0.4)`, opacity: 1 },
                  { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) rotate(${angle}deg) scaleX(1)`, opacity: 0 },
                ],
                { duration: 450, easing: "cubic-bezier(0.16, 1, 0.3, 1)" }
              )
              .finished.then(() => shard.remove())
              .catch(() => shard.remove());
          }
        });

        // Page transition: wipe in before leaving for another page.
        document.addEventListener("click", (e) => {
          const link = (e.target as Element).closest?.("a") as HTMLAnchorElement | null;
          if (!link || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (link.target || link.hasAttribute("download") || link.origin !== location.origin) return;
          if (link.pathname === location.pathname && link.search === location.search) return;
          if (/\.(pdf|xml|zip)$/i.test(link.pathname)) return;
          (window as any).sfx?.confirm();
          // The label of the clicked menu entry morphs into the next page's title.
          const label = link.querySelector<HTMLElement>("[data-vt-title]");
          if (label) label.style.viewTransitionName = "page-title";
          if (nativeVT) return;
          e.preventDefault();
          document.body.classList.add("is-leaving");
          setTimeout(() => location.assign(link.href), 320);
        });
        window.addEventListener("pageshow", () => {
          document.body.classList.remove("is-leaving");
          document.querySelectorAll<HTMLElement>("[data-vt-title]").forEach((el) => (el.style.viewTransitionName = ""));
        });
      }
    </script>
  </body>
</html>
