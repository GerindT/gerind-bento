---
import Layout from "../layouts/Layout.astro";
import { shelves, mediaCount } from "../lib/media";
import CallingCard from "../components/CallingCard.astro";
import { mediaCard, slugify } from "../lib/cards";

const cards = shelves.flatMap((s) => s.items.map((it) => mediaCard(it, s)));
---

<Layout
  title="Media I have enjoyed — Gerind Tershana"
  description={`${mediaCount} books, films, manga and xkcd strips Gerind Tershana keeps coming back to, from Norwegian Wood to Interstellar and xkcd's "Standards".`}
  page="media"
>
  <main id="main" class="page wrap">
    <header class="page__head">
      <h1 class="page__title slam">Media</h1>
      <p class="page__lede slam" style="--i:1">Books, movies, manga and the comics every developer quotes. Pick one for its card.</p>
    </header>

    {
      shelves.map((shelf, si) => (
        <section class="shelf" aria-labelledby={`shelf-${shelf.id}`}>
          <h2 id={`shelf-${shelf.id}`}>{shelf.title}</h2>
          <ul class="covers">
            {shelf.items.map((item, ii) => (
              <li>
                <a class:list={["cover", { "cover--comic": item.comic }]} href={`/media?p=${slugify(item.title)}`} data-cc-open={slugify(item.title)}>
                  <span class="cover__img">
                    <img src={item.img} alt="" loading={si === 0 ? "eager" : "lazy"} fetchpriority={si === 0 && ii < 2 ? "high" : undefined} decoding="async" width={item.comic?.w ?? 320} height={item.comic?.h ?? 384} />
                  </span>
                  <span class="cover__title">
                    {item.title}
                    <span class="cover__by">{item.by} · {item.year}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {shelf.id === "xkcd" && (
            <p class="shelf__credit">
              Comics by Randall Munroe, <a href="https://xkcd.com" target="_blank" rel="noopener noreferrer">xkcd.com</a>, shared under{" "}
              <a href="https://creativecommons.org/licenses/by-nc/2.5/" target="_blank" rel="noopener noreferrer">CC BY-NC 2.5</a>.
            </p>
          )}
        </section>
      ))
    }
  </main>
  <CallingCard items={cards} />
</Layout>
