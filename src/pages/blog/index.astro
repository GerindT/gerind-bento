---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { formatDate } from "../../lib/helpers";

const posts = (await getCollection("blog")).sort((a, b) => (b.data.pubDate?.getTime() ?? 0) - (a.data.pubDate?.getTime() ?? 0));
---

<Layout
  title="Blog — Gerind Tershana"
  description="Notes from Gerind Tershana on programming, web development and the projects behind the portfolio."
  page="blog"
>
  <main id="main" class="page wrap">
    <header class="page__head">
      <h1 class="page__title slam">Blog</h1>
      <p class="page__lede slam" style="--i:1">Notes on programming, web development and what I'm building.</p>
    </header>
    <ul class="posts" role="list">
      {
        posts.map((post) => (
          <li>
            <a class="post-row" href={`/blog/${post.slug}/`}>
              <h2>{post.data.title}</h2>
              {post.data.pubDate && <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>}
              {post.data.description && <p>{post.data.description}</p>}
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
