---
import { Icon } from "astro-icon/components";
import Layout from "../layouts/Layout.astro";
import Poster from "../components/Poster.astro";
import CallingCard from "../components/CallingCard.astro";
import { projectCard } from "../lib/cards";
import { LINKS } from "../lib/constants";
import { allProjects, featuredProjects, liveCount, projectsByGroup } from "../lib/projects";
import { mediaCount, shelves } from "../lib/media";
import { jobs } from "../lib/career";
import { photos, hasPhotos } from "../lib/photos";

const now = jobs[0];
const selected = featuredProjects.slice(0, 6);

type MenuItem = { href: string; title: string; desc: string; meta: string; thumb?: string; thumbPos?: string; covers?: string[]; icon?: string; download?: boolean; alt?: { href: string; label: string } };

const menu: MenuItem[] = [
  { href: "/projects", title: "Projects", desc: "Products, games and client platforms, grouped by where I built them.", meta: `${allProjects.length} builds · ${liveCount} live`, thumb: featuredProjects[0]?.img },
  { href: "/about", title: "About", desc: `${now.role} at ${now.org}. Career, education, tools and the countries I've been to.`, meta: "5+ years", thumb: "/Gerind_Tershana.webp", thumbPos: "50% 34%" },
  { href: "/media", title: "Media", desc: "The books, movies and manga I keep coming back to.", meta: `${mediaCount} favourites`, covers: shelves.map((s) => s.items[0].img) },
  ...(hasPhotos ? [{ href: "/photos", title: "Photos", desc: "Photography is my newest hobby. Frames from walks, trips and rides.", meta: `${photos.length} ${photos.length === 1 ? "photo" : "photos"}`, icon: "ri:camera-3-line" }] : []),
  { href: "/Gerind_Tershana_EN.pdf", title: "CV", desc: "Downloads my CV as a PDF, in English. There's an Albanian version too.", meta: "PDF · EN / SQ", icon: "ri:file-download-line", download: true, alt: { href: "/Gerind_Tershana_AL.pdf", label: "CV · Shqip" } },
  { href: "#contact", title: "Contact", desc: `Open to freelance and full-time work. Write to ${LINKS.email}.`, meta: "Freelance · Full-time", icon: "ri:mail-send-line" },
];

const gifs = [
  { src: "/Gerind_Tershana.webp", alt: "Portrait of Gerind Tershana", mascot: false },
  { src: "/gif_me.gif", alt: "Animated pixel-art white cat", mascot: true },
  { src: "/gif_psy.gif", alt: "Animated pixel-art Psyduck", mascot: true },
  { src: "/gif_tot.gif", alt: "Animated pixel-art Totoro sleeping with a child", mascot: true },
  { src: "/gif_kirby.gif", alt: "Animated pixel-art Kirby holding an umbrella", mascot: true },
];

const ticker = ["Open to work", "Tirana, Albania", "Go", "Vue & Nuxt", "React", "Laravel", "Flutter", "Godot", "CI/CD", "System design"];
---

<Layout
  title="Gerind Tershana — Software Engineer, Tech Lead & System Architect"
  description="Gerind Tershana: Tech Lead & System Architect at Innovation4Albania, previously at Detag. 5+ years building scalable web apps and high-concurrency APIs in Tirana, Albania. Open to freelance and full-time work."
  page="home"
>
  <main id="main">
    <section class="hero" aria-labelledby="name">
      <div class="hero__bg" aria-hidden="true"></div>
      <div class="wrap hero__grid">
        <div class="hero__copy">
          <h1 class="name" id="name">
            <span class="name__slash" aria-hidden="true"></span>
            <span class="name__line name__line--a slam" style="--i:0">Gerind</span>
            <span class="name__line name__line--b slam" style="--i:1">Tershana</span>
          </h1>
          <p class="strip hero__role slam" style="--i:2">{now.role} · {now.org}</p>
          <p class="hero__lede slam" style="--i:3">
            5+ years building <strong>scalable</strong> web apps, high-concurrency APIs and the pipelines that ship them.
          </p>
          <p class="avail slam" style="--i:4">
            <span class="pulse" aria-hidden="true"></span>
            Open to freelance and full-time work
          </p>
        </div>

        <figure class="portrait slam" style="--i:3" id="portrait-fig">
          <div class="portrait__frame">
            <img id="portrait" src={gifs[0].src} alt={gifs[0].alt} width="360" height="480" loading="eager" fetchpriority="high" decoding="async" />
            <span class="portrait__flash" aria-hidden="true"></span>
          </div>
          <button type="button" class="btn btn--ghost portrait__swap" id="swap" aria-describedby="swap-count">
            <Icon name="ri:shuffle-line" aria-hidden="true" />
            Not me? Swap
          </button>
          <span class="portrait__count" id="swap-count" aria-live="polite"><span class="sr-only">Portrait </span><b>1</b>/{gifs.length}</span>
        </figure>

        <nav class="menu hero__menu" aria-labelledby="menu-title">
          <div class="menu__col">
          <h2 class="menu__label slam" style="--i:5" id="menu-title">Where to?</h2>
          <ul class="menu__list" id="menu" role="list">
            {
              menu.map((item, i) => (
                <li class="slam" style={`--i:${i + 6}`}>
                  <a
                    class:list={["menu__item", { "is-active": i === 0 }]}
                    href={item.href}
                    download={item.download ? "" : undefined}
                    data-i={i}
                    aria-describedby={`menu-desc-${i}`}
                  >
                    <span data-vt-title>{item.title}</span>
                    <Icon name={item.download ? "ri:download-2-line" : item.href.startsWith("#") ? "ri:arrow-down-line" : "ri:arrow-right-up-line"} aria-hidden="true" />
                  </a>
                  <span class="sr-only" id={`menu-desc-${i}`}>{item.desc} {item.meta}.</span>
                </li>
              ))
            }
          </ul>
          </div>
          <div class="menu__stage slam" style="--i:7" aria-hidden="true">
            {
              menu.map((item, i) => (
                <div class:list={["menu__preview", { "is-active": i === 0 }]} data-preview={i}>
                  <span class="menu__ghost" style={`--n:${item.title.length}`}>{item.title}</span>
                  <div class:list={["menu__thumb", { "menu__thumb--covers": item.covers }]}>
                    {item.covers ? (
                      item.covers.map((src) => <img src={src} alt="" loading="lazy" decoding="async" width="120" height="180" />)
                    ) : item.thumb ? (
                      <img src={item.thumb} alt="" loading="lazy" decoding="async" width="320" height="200" style={item.thumbPos ? `object-position:${item.thumbPos}` : undefined} />
                    ) : (
                      <Icon name={item.icon ?? "ri:arrow-right-up-line"} />
                    )}
                  </div>
                  <div class="menu__text">
                    <h3>{item.title}</h3>
                    <p>{item.desc}</p>
                  </div>
                  <span class="menu__preview-meta">{item.meta}</span>
                </div>
              ))
            }
          </div>
        </nav>
      </div>
    </section>

    <div class="ticker-clip" aria-hidden="true">
      <div class="ticker">
        <div class="ticker__track">
          {[0, 1].map(() => <span class="ticker__run">{ticker.map((t) => <span>{t}</span>)}</span>)}
        </div>
      </div>
    </div>

    <section class="section section--paper section--slashed" aria-labelledby="work-title">
      <div class="wrap">
        <div class="section__head">
          <h2 class="section-title reveal" id="work-title">Selected work</h2>
          <a class="btn btn--primary" href="/projects">
            All {allProjects.length} projects
            <Icon name="ri:arrow-right-line" aria-hidden="true" />
          </a>
        </div>
        <ul class="groupline reveal" role="list" aria-label="Projects by group">
          {
            projectsByGroup.map((g) => (
              <li>
                <a href={`/projects#${g.id}`}>
                  <b>{g.count}</b> {g.short}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="posters posters--home">
          {selected.map((p, i) => <Poster project={p} index={i} feature={i === 0} />)}
        </div>
      </div>
    </section>

    <section class="section section--accent section--slashed contact" id="contact" aria-labelledby="contact-title">
      <div class="wrap">
        <div class="card reveal">
          <h2 id="contact-title">Let's build something <mark>great</mark> together</h2>
          <p>Open to freelance projects and full-time roles. Have something in mind, or just want to say hello? Write to me and I'll get back to you.</p>
          <a class="card__mail" href={LINKS.gmail}>{LINKS.email}</a>
          <a class="card__mail card__mail--alt" href={LINKS.outlook}>{LINKS.email2}</a>
          <div class="card__actions">
            <a class="btn btn--primary" href="/Gerind_Tershana_EN.pdf" download>
              <Icon name="ri:download-2-line" aria-hidden="true" />
              CV · English
            </a>
            <a class="btn btn--primary" href="/Gerind_Tershana_AL.pdf" download>
              <Icon name="ri:download-2-line" aria-hidden="true" />
              CV · Shqip
            </a>
          </div>
          <ul class="socials" role="list" aria-label="Elsewhere">
            <li><a href={LINKS.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="ri:linkedin-box-fill" aria-hidden="true" />LinkedIn</a></li>
            <li><a href={LINKS.github} target="_blank" rel="noopener noreferrer"><Icon name="ri:github-fill" aria-hidden="true" />GitHub</a></li>
            <li><a href={LINKS.telegram} target="_blank" rel="noopener noreferrer"><Icon name="ri:telegram-fill" aria-hidden="true" />Telegram</a></li>
            <li><a href={LINKS.instagram} target="_blank" rel="noopener noreferrer"><Icon name="ri:instagram-line" aria-hidden="true" />Instagram</a></li>
          </ul>
        </div>
      </div>
    </section>
  </main>
  <CallingCard items={selected.map((p) => projectCard(p, "home"))} />

  <script define:vars={{ gifs }}>
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ease = "cubic-bezier(0.16, 1, 0.3, 1)";

    // Easter egg: cycle the pixel mascots, with a flash frame and a counter stamp.
    const portrait = document.getElementById("portrait");
    const fig = document.getElementById("portrait-fig");
    const count = document.querySelector("#swap-count b");
    const flash = document.querySelector(".portrait__flash");
    let gifIndex = 0;
    document.getElementById("swap")?.addEventListener("click", () => {
      gifIndex = (gifIndex + 1) % gifs.length;
      portrait.src = gifs[gifIndex].src;
      portrait.alt = gifs[gifIndex].alt;
      portrait.classList.toggle("is-mascot", gifs[gifIndex].mascot);
      count.textContent = String(gifIndex + 1);
      window.sfx?.confirm();
      if (reduce) return;
      flash.animate([{ opacity: 0.9 }, { opacity: 0 }], { duration: 260, easing: "ease-out" });
      fig.querySelector(".portrait__frame").animate(
        [{ transform: "rotate(3deg) scale(1)" }, { transform: "rotate(-2deg) scale(1.04)" }, { transform: "rotate(3deg) scale(1)" }],
        { duration: 380, easing: ease }
      );
      count.parentElement.animate([{ transform: "rotate(8deg) scale(1.6)" }, { transform: "rotate(8deg) scale(1)" }], { duration: 300, easing: ease });
    });

    // Gentle pointer parallax on the portrait (desktop pointers only).
    if (!reduce && window.matchMedia("(pointer: fine)").matches) {
      let raf = 0;
      document.querySelector(".hero")?.addEventListener("pointermove", (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const x = (e.clientX / window.innerWidth - 0.5) * 2;
          const y = (e.clientY / window.innerHeight - 0.5) * 2;
          fig.style.setProperty("--px", `${(x * 8).toFixed(1)}px`);
          fig.style.setProperty("--py", `${(y * 6).toFixed(1)}px`);
        });
      });
    }

    // Menu: hover/focus drives the preview plate, which cuts in like a pause menu.
    const items = Array.from(document.querySelectorAll(".menu__item"));
    const previews = Array.from(document.querySelectorAll("[data-preview]"));
    let active = 0;
    const activate = (i) => {
      if (i === active) return;
      const dir = i > active ? 1 : -1;
      active = i;
      items.forEach((el, k) => el.classList.toggle("is-active", k === i));
      previews.forEach((p, k) => p.classList.toggle("is-active", k === i));
      window.sfx?.tick();
      if (reduce) return;
      const p = previews[i];
      p.animate(
        [
          { transform: `translate(${2.5 * dir}rem, ${-0.6 * dir}rem) rotate(${3 * dir}deg)`, clipPath: "polygon(0 0, 0 0, 0 100%, 0 100%)" },
          { transform: "rotate(1deg)", clipPath: "polygon(0 0, 100% 0, 100% 100%, 0 100%)" },
        ],
        { duration: 380, easing: ease }
      );
      p.querySelector(".menu__ghost")?.animate([{ transform: "translateX(-12%) skewX(-12deg)", opacity: 0 }, { transform: "skewX(-12deg)", opacity: 1 }], { duration: 520, easing: ease });
    };
    items.forEach((el, i) => {
      el.addEventListener("mouseenter", () => activate(i));
      el.addEventListener("focus", () => activate(i));
    });
    // ↑/↓ drive the menu like a pause screen: from a menu item, or from anywhere on the page
    // while the menu is on screen and nothing else has focus.
    const menuEl = document.getElementById("menu");
    let menuVisible = true;
    if (menuEl) new IntersectionObserver(([en]) => (menuVisible = en.isIntersecting)).observe(menuEl);
    document.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowDown" && e.key !== "ArrowUp") return;
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      const focused = document.activeElement;
      const i = items.indexOf(focused);
      const idle = !focused || focused === document.body || focused === document.documentElement;
      if (i < 0 && !(idle && menuVisible && document.documentElement.dataset.keys !== "off")) return;
      if (document.querySelector("dialog[open], details[open]")) return;
      e.preventDefault();
      const from = i < 0 ? active : i;
      items[(from + (e.key === "ArrowDown" ? 1 : -1) + items.length) % items.length].focus();
    });
  </script>
</Layout>
