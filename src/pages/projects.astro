---
import Layout from "../layouts/Layout.astro";
import Poster from "../components/Poster.astro";
import { allProjects, liveCount } from "../lib/projects";

const jsonLd = [
  {
    "@type": "CollectionPage",
    "@id": "https://gerindtershana.netlify.app/projects#page",
    name: "Projects by Gerind Tershana",
    url: "https://gerindtershana.netlify.app/projects",
    isPartOf: { "@id": "https://gerindtershana.netlify.app/#website" },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: allProjects.map((p, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: p.title,
        ...(p.site ? { url: p.site } : {}),
      })),
    },
  },
];
---

<Layout
  title="Projects — Gerind Tershana"
  description={`${allProjects.length} web projects by Gerind Tershana, from client platforms to experiments, built with Vue, Nuxt, React, Go, Laravel and Node.js. ${liveCount} are live today.`}
  page="projects"
  jsonLd={jsonLd}
>
  <main id="main" class="page wrap">
    <header class="page__head">
      <h1 class="page__title slam">Projects</h1>
      <p class="page__lede slam" style="--i:1">{allProjects.length} builds since 2021, {liveCount} of them live. Private client work is marked, since I can't always link it.</p>
    </header>
    <h2 class="sr-only">All projects</h2>
    <section class="posters" aria-label="Project list">
      {allProjects.map((p) => <Poster project={p} />)}
    </section>
  </main>
</Layout>
