// Static site on Cloudflare Workers (static assets only, no Worker code).
// Deploy: pnpm run deploy  (builds with Astro, then uploads dist/)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gerind",
  "account_id": "204e38c96b8f69e4c17f9b85defcc92d",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  },
  "routes": [{ "pattern": "gerind.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
